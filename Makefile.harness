HARNESS_VERSION := 0.2.0

.PHONY: version smoke test lint typecheck check task-contract mobile-preflight mobile-run mobile-ios-smoke mobile-typecheck mobile-test audit ci harness-extensions perf metrics

version:
	@echo "Harness version: $(HARNESS_VERSION)"

smoke:
	@./scripts/harness/smoke.sh

test:
	@./scripts/harness/test.sh

lint:
	@./scripts/harness/lint.sh

typecheck:
	@./scripts/harness/typecheck.sh

mobile-typecheck:
	@./scripts/harness/mobile_typecheck.sh

mobile-test:
	@./scripts/harness/mobile_test.sh

check: lint typecheck

task-contract:
	@./bin/check-task-contract "$(if $(CONTRACT),$(CONTRACT),./examples/agent-task-contract.json)"

mobile-preflight:
	@./bin/check-mobile-toolchain

mobile-run:
	@./scripts/harness/mobile_run.sh

mobile-ios-smoke:
	@./scripts/harness/mobile_ios_smoke.sh

audit:
	@python3 ./scripts/harness_wizard.py audit .

ci: smoke check test

harness-extensions:
	@./bin/check-stale-contracts
	@python3 ./bin/check-dart-imports
	@./bin/check-python-lint
	@./bin/check-changelog
	@./bin/check-pub-outdated

perf:
	@./bin/check-perf

metrics:
	@./bin/check-metrics
.PHONY: smoke test lint typecheck check task-contract mobile-preflight mobile-typecheck mobile-test audit ci

smoke:
	@./scripts/harness/smoke.sh

test:
	@./scripts/harness/test.sh

lint:
	@./scripts/harness/lint.sh

typecheck:
	@./scripts/harness/typecheck.sh

mobile-typecheck:
	@./scripts/harness/mobile_typecheck.sh

mobile-test:
	@./scripts/harness/mobile_test.sh

check: lint typecheck

task-contract:
	@./bin/check-task-contract "$(if $(CONTRACT),$(CONTRACT),./examples/agent-task-contract.json)"

mobile-preflight:
	@./bin/check-mobile-toolchain

audit:
	@python3 ./scripts/harness_wizard.py audit .

ci: smoke check test
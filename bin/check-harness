#!/bin/sh
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)

if [ ! -f "$ROOT_DIR/AGENTS.md" ]; then
  echo "ERROR: missing AGENTS.md"
  exit 1
fi

if ! grep -q "docs/ is the canonical source of truth" "$ROOT_DIR/AGENTS.md"; then
  echo "ERROR: AGENTS.md is missing the docs canonical-source rule"
  exit 1
fi

if ! grep -q "Version 1 is local-only" "$ROOT_DIR/AGENTS.md"; then
  echo "ERROR: AGENTS.md is missing the local-only v1 rule"
  exit 1
fi

if ! grep -q "Home quick actions declared in docs must map to real user-completable flows" "$ROOT_DIR/AGENTS.md"; then
  echo "ERROR: AGENTS.md is missing the quick-action implementation rule"
  exit 1
fi

if ! grep -q "Mobile runtime-validation must include iOS launch-surface checks" "$ROOT_DIR/AGENTS.md"; then
  echo "ERROR: AGENTS.md is missing the iOS runtime-validation rule"
  exit 1
fi

"$ROOT_DIR/bin/check-docs"
"$ROOT_DIR/bin/check-constraints"
"$ROOT_DIR/bin/check-gc"

echo "OK: harness checks passed"
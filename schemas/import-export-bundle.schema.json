{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.personal-field-work-agent/schemas/import-export-bundle.schema.json",
  "title": "Personal Field Work Agent Import Export Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "exported_at",
    "source_app",
    "scope",
    "records",
    "attachments_manifest"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^v[0-9]+$"
    },
    "bundle_id": {
      "type": "string",
      "minLength": 1
    },
    "exported_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["project", "meeting", "date_range", "task_filter", "full_export"]
        },
        "value": {}
      }
    },
    "records": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projects", "tasks", "meetings", "people"],
      "properties": {
        "projects": {
          "type": "array",
          "items": { "type": "object" }
        },
        "tasks": {
          "type": "array",
          "items": { "type": "object" }
        },
        "meetings": {
          "type": "array",
          "items": { "type": "object" }
        },
        "people": {
          "type": "array",
          "items": { "type": "object" }
        }
      }
    },
    "attachments_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attachment_id",
          "owner_record_type",
          "owner_record_id",
          "relative_path",
          "checksum"
        ],
        "properties": {
          "attachment_id": { "type": "string", "minLength": 1 },
          "owner_record_type": {
            "type": "string",
            "enum": ["project", "task", "meeting", "raw_capture", "export_bundle"]
          },
          "owner_record_id": { "type": "string", "minLength": 1 },
          "relative_path": { "type": "string", "minLength": 1 },
          "checksum": { "type": "string", "minLength": 1 },
          "mime_type": { "type": ["string", "null"] }
        }
      }
    }
  }
}